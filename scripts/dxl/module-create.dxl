// Formal-module creation. Preview is database-read-only; commit requires an approved plan.
// No folder creation, overwrite, delete, ACL change, forced unlock or automatic retry.
// Inputs are escaped string literals generated by DxlExecutor, never evaluated as DXL.

string mcEscape(string value) {
    Buffer b = create
    b = ""
    int i
    for (i = 0; i < length(value); i++) {
        char c = value[i]
        if (c == '\\') b += "\\\\"
        else if (c == '\t') b += "\\t"
        else if (c == '\r') b += "\\r"
        else if (c == '\n') b += "\\n"
        else b += c
    }
    string text = stringOf(b)
    delete(b)
    return text
}

string mcFold(string value) {
    Buffer b = create
    b = value
    setupper(b)
    string text = stringOf(b)
    delete(b)
    return text
}

string mcAncestorLock(string lockedId, string folderPath) {
    // fullName() is relative to the nearest ancestor project in the documented API.
    // Resolve absolute ancestor paths and compare stable IDs, including nested projects.
    string ancestorPath = folderPath
    while (true) {
        Item ancestorItem = item(ancestorPath)
        if (null ancestorItem) return "Unknown"
        if (uniqueID(ancestorItem) == lockedId) return "Locked"
        if (ancestorPath == "/") return "NoBlockingLockObserved"
        int separator = length(ancestorPath) - 1
        while (separator > 0 && ancestorPath[separator] != '/') separator--
        if (separator == 0) ancestorPath = "/"
        else ancestorPath = ancestorPath[0:(separator-1)]
    }
    return "Unknown"
}

string mcPath = di_arg_folder "/" di_arg_name
if (di_arg_folder == "/") mcPath = "/" di_arg_name
string mcDatabase = "", mcUser = "", mcFolderId = ""
string mcFolderStatus = "DeniedOrNotFound", mcPermission = "Unknown"
string mcNameStatus = "Unknown", mcDescriptionStatus = "Unknown"
string mcCollision = "Unknown", mcLocks = "Unknown"
string mcOutcome = "Preview", mcModuleId = "", mcQualifiedId = "", mcCleanup = "NotRequired"
Folder mcFolder = null

// Read-only preflight, also rerun inside the single approved commit invocation.
noError()
mcDatabase = getDatabaseIdentifier()
mcUser = doorsname()
bool mcValidName = isValidName(di_arg_name)
bool mcValidDescription = isValidDescription(di_arg_description)
mcNameStatus = "Invalid"
mcDescriptionStatus = "Invalid"
if (mcValidName) mcNameStatus = "Valid"
if (mcValidDescription) mcDescriptionStatus = "Valid"
Item mcFolderItem = item(di_arg_folder)
if (!null mcFolderItem) {
    string mcFolderType = type(mcFolderItem)
    if (isDeleted(mcFolderItem)) {
        mcFolderStatus = "DeniedOrNotFound"
    } else if (mcFolderType != "Folder" && mcFolderType != "Project") {
        mcFolderStatus = "NotContainer"
    } else if (!canRead(mcFolderItem)) {
        mcFolderStatus = "DeniedOrNotFound"
    } else {
        mcFolder = folder(di_arg_folder)
        if (null mcFolder) mcFolderStatus = "Unavailable"
        else {
            mcFolderStatus = "Readable"
            mcFolderId = uniqueID(mcFolder)
            mcPermission = "Denied"
            if (canCreate(mcFolder)) mcPermission = "Allowed"
            mcCollision = "NoVisibleConflict"
            Item mcExisting = item(mcPath)
            if (!null mcExisting) mcCollision = "Conflict"
            // Include readable deleted items; a reserved/deleted name must not be reused by this service.
            // Null item() alone cannot prove absence of a hidden name. Native create remains authoritative.
            Item mcChild
            int mcChildren = 0
            string mcRequestedName = mcFold(di_arg_name)
            for mcChild in all mcFolder do {
                mcChildren++
                if (mcChildren > 10000 || null mcChild) {
                    mcCollision = "Unknown"
                    break
                }
                if (mcFold(name(mcChild)) == mcRequestedName) {
                    mcCollision = "Conflict"
                    break
                }
            }
        }
    }
}
string mcPreflightError = lastError()
if (!null mcPreflightError) {
    mcFolderStatus = "Unavailable"
    mcPermission = "Unknown"
    mcCollision = "Unknown"
}

if (mcFolderStatus == "Readable") {
    // isLocked is documented for ModName_, NOT Folder. Inspect reported ancestor write locks instead.
    // allUsers=true requires May Manage; null/error/limit is Unknown and blocks commit.
    // IBM excludes currently open items from this list: NoBlockingLockObserved is advisory, never a lock reservation.
    noError()
    LockList mcLockList = getLocksInDatabase(true)
    if (!null mcLockList) {
        mcLocks = "NoBlockingLockObserved"
        Lock mcLock
        int mcLockCount = 0
        for mcLock in mcLockList do {
            mcLockCount++
            if (mcLockCount > 10000) {
                mcLocks = "Unknown"
                break
            }
            if (mcLock.lockMode == lockWrite) {
                Item mcLockedItem = mcLock.item
                if (null mcLockedItem) {
                    mcLocks = "Unknown"
                    break
                }
                string mcAncestorStatus = mcAncestorLock(uniqueID(mcLockedItem), di_arg_folder)
                if (mcAncestorStatus != "NoBlockingLockObserved") {
                    mcLocks = mcAncestorStatus
                    break
                }
            }
        }
        delete(mcLockList) // Frees the local list; does not remove any database lock.
    }
    string mcLockError = lastError()
    if (!null mcLockError) mcLocks = "Unknown"
}

bool mcReady = mcFolderStatus == "Readable" && mcPermission == "Allowed" &&
    mcNameStatus == "Valid" && mcDescriptionStatus == "Valid" &&
    mcCollision == "NoVisibleConflict" && mcLocks == "NoBlockingLockObserved" &&
    mcDatabase != "" && mcUser != "" && mcFolderId != ""

if (di_arg_mode == "commit") {
    mcOutcome = "Blocked"
    if (length(di_arg_approvedPlan) != 32 || di_arg_expectedDatabase == "" ||
        di_arg_expectedUser == "" || di_arg_expectedFolderId == "") {
        // Defense in depth: managed gateway also requires a one-use capability authorized by ModuleService.
        di_error = "ApprovalRequired"
    } else if (mcDatabase != di_arg_expectedDatabase || mcUser != di_arg_expectedUser || mcFolderId != di_arg_expectedFolderId) {
        mcOutcome = "ContextChanged"
    } else if (mcReady) {
        // Exactly one native create, using an absolute path. Never open an existing module for edit.
        mcOutcome = "OutcomeUnknown"
        noError()
        Module mcCreated = create(mcPath, di_arg_description, "", 1, false)
        string mcCreateError = lastError()
        if (!null mcCreated) {
            mcCleanup = "Failed"
            noError()
            mcModuleId = uniqueID(mcCreated)
            mcQualifiedId = qualifiedUniqueID(mcCreated)
            bool mcIdentityMatches = false
            Item mcCreatedAtTarget = item(mcPath)
            if (!null mcCreatedAtTarget) {
                mcIdentityMatches = type(mcCreatedAtTarget) == "Formal" && uniqueID(mcCreatedAtTarget) == mcModuleId &&
                    qualifiedUniqueID(mcCreatedAtTarget) == mcQualifiedId && mcModuleId != "" && mcQualifiedId != ""
            }
            string mcIdentityError = lastError()
            if (null mcCreateError && null mcIdentityError && mcIdentityMatches) {
                noError()
                save(mcCreated)
                bool mcStillUnsaved = unsaved(mcCreated)
                string mcSaveError = lastError()
                if (null mcSaveError && !mcStillUnsaved) {
                    noError()
                    // Save triggers may change metadata. Verify persisted target identity/description before success.
                    bool mcPersistedMatches = false
                    Item mcPersisted = item(mcPath)
                    if (!null mcPersisted) {
                        mcPersistedMatches = type(mcPersisted) == "Formal" && uniqueID(mcPersisted) == mcModuleId &&
                            qualifiedUniqueID(mcPersisted) == mcQualifiedId && description(mcPersisted) == di_arg_description
                    }
                    string mcVerifyError = lastError()
                    if (null mcVerifyError && mcPersistedMatches) {
                        mcOutcome = "Created"
                        noError()
                        bool mcClosed = close(mcCreated, false) // Saved already; no interactive save prompt.
                        string mcCloseError = lastError()
                        if (mcClosed && null mcCloseError) mcCleanup = "Closed"
                    }
                }
            }
            // Save/identity failure: leave the owned module open, report uncertainty; never discard or delete it.
            if (mcModuleId == "" || mcQualifiedId == "") {
                mcModuleId = ""
                mcQualifiedId = ""
            }
        }
    }
} else if (di_arg_mode != "preview" || di_arg_approvedPlan != "") {
    di_error = "InvalidMode"
}

Buffer mcOutput = create
mcOutput = "DOORS_MODULE_CREATE|1|" di_requestId "\n"
mcOutput += "P\t" mcEscape(mcPath) "\t" mcEscape(mcDatabase) "\t" mcEscape(mcUser) "\t" mcEscape(mcFolderId) "\t"
mcOutput += mcFolderStatus "\t" mcPermission "\t" mcNameStatus "\t" mcDescriptionStatus "\t" mcCollision "\t" mcLocks "\n"
mcOutput += "R\t" mcOutcome "\t" mcEscape(mcModuleId) "\t" mcEscape(mcQualifiedId) "\t" mcCleanup "\nEND\n"
oleSetResult(stringOf(mcOutput))
delete(mcOutput)
