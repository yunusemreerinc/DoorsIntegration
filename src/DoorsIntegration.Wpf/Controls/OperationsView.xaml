<UserControl x:Class="DoorsIntegration.Wpf.Controls.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/>
        <Grid Grid.Column="2" DataContext="{Binding Selected}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.4*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="3,6,3,12"/></StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="30"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Multiline}" Value="True"><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="MinHeight" Value="90"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></TextBox.Style>
                                </TextBox>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                </ComboBox>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" Content="Etkin">
                                    <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                </CheckBox>
                                <Button Grid.Column="2" Content="Seç…" Command="{Binding Browse}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasBrowser}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid ItemsSource="{Binding Attributes}" Height="280" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAttributes}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Değiştir" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn Header="Tip / enum / erişim" Binding="{Binding Metadata}" IsReadOnly="True" Width="210"/>
                            <DataGridCheckBoxColumn Header="Zorunlu" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="Format" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" IsEnabled="{Binding CanEdit}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Yeni değer" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Grid IsEnabled="{Binding CanEdit}">
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding SingleEnum}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                    <ComboBox ItemsSource="{Binding EnumerationValues}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SingleEnum}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                </Grid>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rich text beklenen plain" Binding="{Binding ExpectedPlain, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Actions}" Margin="0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBox Grid.Row="3" Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</UserControl>
