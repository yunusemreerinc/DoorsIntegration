<UserControl x:Class="DoorsIntegration.Wpf.Controls.BaselineTraceabilityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DoorsIntegration.Wpf.Controls">
 <Grid Margin="4" IsEnabled="{Binding IsIdle}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="210"/><RowDefinition Height="6"/><RowDefinition Height="230" MinHeight="150"/></Grid.RowDefinitions>
  <StackPanel>
   <Border Background="#14354D" CornerRadius="5" Padding="10,7"><StackPanel><TextBlock Text="BASELINE SET OVERVIEW" Foreground="#7BC9FF" FontWeight="Bold"/><TextBlock Text="{Binding Banner}" FontSize="11"/><TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
   <WrapPanel><TextBlock Text="Folder" Margin="4,7"/><TextBox Width="155" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Definition ID" Margin="4,7"/><TextBox Width="225" Text="{Binding DefinitionId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Set ID" Margin="4,7"/><TextBox Width="225" Text="{Binding SetId, UpdateSourceTrigger=PropertyChanged}"/>
    <Button Content="Use Selected Native Set" Command="{Binding UseNativeSelectionCommand}"/><Button Content="Mock Demo" Command="{Binding DemoCommand}"/>
   </WrapPanel>
   <WrapPanel><TextBlock Text="Link modules (; separated)" Margin="4,7"/><TextBox Width="265" Text="{Binding LinkModules, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Selected module IDs (blank = all)" Margin="4,7"/><TextBox Width="190" Text="{Binding SelectedModuleIds, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="BaselineTraceabilityVerify" Content="Verify Read-only" Command="{Binding VerifyCommand}" Background="#126CA5"/><Button Content="Capture Reference Now" Command="{Binding CaptureReferenceCommand}"/><Button Content="Import Recorded Reference" Command="{Binding ImportReferenceCommand}"/><Button Content="Clear Reference" Command="{Binding ClearReferenceCommand}"/>
   </WrapPanel>
   <TextBlock Text="{Binding ReferenceLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="4"/>
   <Expander Header="Project Traceability Policy (JSON)" Margin="4"><TextBox Height="110" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Text="{Binding PolicyJson, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto" MaxLength="131072"/></Expander>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="320" MinWidth="230"/></Grid.ColumnDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="TRACEABILITY GRAPH" FontWeight="Bold" Margin="4,7"/><TextBox x:Name="BaselineGraphSearch" Width="170" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search module, version, type, identifier or Absolute Number"/><ComboBox Width="95" ItemsSource="{Binding Roles}" SelectedItem="{Binding RoleFilter}"/>
    <ComboBox Width="105" ItemsSource="{Binding Directions}" SelectedItem="{Binding ImpactDirection}"/><TextBox Width="40" Text="{Binding ImpactDepth}" ToolTip="Multi-hop depth 0–100"/><Button Content="Impact" Command="{Binding ImpactCommand}"/><Button Content="Clear" Command="{Binding ClearImpactCommand}"/>
   </WrapPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding RenderSummary}" FontSize="10" Foreground="{StaticResource Muted}" Margin="4"/>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:BaselineTraceabilityGraph x:Name="BaselineVersionGraph" Scene="{Binding Scene}" SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}" SelectedEdgeId="{Binding SelectedEdgeId, Mode=TwoWay}"/></ScrollViewer>
   </DockPanel>
   <GridSplitter Grid.Column="1"/>
   <DockPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock DockPanel.Dock="Top" Text="REQUIREMENT / LINK DETAILS" FontWeight="Bold" Margin="4"/><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel>
  </Grid>
  <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
  <DockPanel Grid.Row="3">
   <StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="VERIFICATION RESULTS" FontWeight="Bold" Margin="4,7"/><ComboBox Width="165" ItemsSource="{Binding FindingFilters}" SelectedItem="{Binding FindingFilter}"/><ComboBox Width="75" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/><Button Content="Export Report" Command="{Binding ExportCommand}"/><TextBox Width="250" Text="{Binding ExportRoot, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel><TextBlock Text="{Binding Summary}" Margin="4" FontWeight="SemiBold"/><TextBlock Text="{Binding Coverage}" Margin="4" TextWrapping="Wrap" FontSize="11"/></StackPanel>
   <TabControl>
    <TabItem Header="Findings"><DataGrid x:Name="BaselineTraceabilityFindings" ItemsSource="{Binding Findings}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/><DataGridCheckBoxColumn Header="Unknown" Binding="{Binding Uncertain}"/><DataGridTextColumn Header="Requirement identity" Binding="{Binding NodeIdentity}" Width="160"/><DataGridTextColumn Header="Explanation / Evidence" Binding="{Binding Explanation}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Module Baselines"><DataGrid ItemsSource="{Binding Modules}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding FullPath}" Width="*"/><DataGridTextColumn Header="Stable ID" Binding="{Binding ModuleIdentity}" Width="130"/><DataGridTextColumn Header="Module Version" Binding="{Binding Version.Version}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100"/><DataGridCheckBoxColumn Header="In Set" Binding="{Binding InSet}"/><DataGridCheckBoxColumn Header="Selected scope" Binding="{Binding SelectedForVerification}"/><DataGridTextColumn Header="Shareable config" Binding="{Binding ShareableConfiguration}" Width="120"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Link Results"><DataGrid ItemsSource="{Binding VerifiedLinks}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/><DataGridTextColumn Header="Source module" Binding="{Binding Link.SourceModuleIdentity}" Width="100"/><DataGridTextColumn Header="Source version" Binding="{Binding Link.SourceVersion.Version}" Width="130"/><DataGridTextColumn Header="Source object" Binding="{Binding Link.SourceObject}" Width="90"/><DataGridTextColumn Header="Target module" Binding="{Binding Link.TargetModuleIdentity}" Width="100"/><DataGridTextColumn Header="Target version" Binding="{Binding Link.TargetVersion.Version}" Width="130"/><DataGridCheckBoxColumn Header="Echo" Binding="{Binding Link.IsEchoed}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   </TabControl>
  </DockPanel>
 </Grid>
</UserControl>
