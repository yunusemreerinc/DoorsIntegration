<UserControl x:Class="DoorsIntegration.Wpf.Controls.NativeBaselineSetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="3">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{Binding Banner}" Foreground="#7BC9FF" FontWeight="Bold" Margin="4"/>
   <TextBlock Text="Real metadata is visibility limited. An unseen member is Unknown; historical set membership can differ from the current definition." TextWrapping="Wrap" Margin="4"/>
   <WrapPanel><TextBlock Text="Definition folder" Margin="4,7"/><TextBox Width="180" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
    <Button Content="List Definitions" Command="{Binding RefreshDefinitionsCommand}"/><ComboBox Width="170" ItemsSource="{Binding Definitions}" DisplayMemberPath="Name" SelectedItem="{Binding Definition}"/>
    <Button Content="Load Definition / Sets" Command="{Binding LoadDefinitionCommand}"/><ComboBox Width="140" ItemsSource="{Binding Sets}" DisplayMemberPath="Version" SelectedItem="{Binding SelectedSet}"/>
    <TextBlock Text="{Binding SetSummary}" Margin="5,7"/>
   </WrapPanel>
   <WrapPanel><TextBlock Text="Name" Margin="4,7"/><TextBox Width="150" MaxLength="256" Text="{Binding DefinitionName, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Description" Margin="4,7"/><TextBox Width="190" MaxLength="16384" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Suffix" Margin="4,7"/><TextBox Width="100" MaxLength="128" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Annotation" Margin="4,7"/><TextBox Width="230" MaxLength="16384" Text="{Binding Annotation, UpdateSourceTrigger=PropertyChanged}"/>
   </WrapPanel>
   <WrapPanel><ComboBox x:Name="NativeAction" Width="180" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"/>
    <Button Content="Preflight / Dry Run" Command="{Binding PreflightCommand}"/><Button Content="Review and Approve" Command="{Binding ReviewCommand}"/>
    <Button x:Name="NativeExecute" Content="Execute Approved Action" Command="{Binding ExecuteCommand}" Background="#126CA5"/>
    <Button Content="Verify Links" Command="{Binding VerifyCommand}"/><TextBlock Text="{Binding Approval}" Margin="5,7"/>
   </WrapPanel>
  </StackPanel>
  <TextBox DockPanel.Dock="Bottom" Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" MinHeight="45" MaxHeight="85" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  <TabControl>
   <TabItem Header="Definition Modules / Set Members"><DataGrid x:Name="NativeMemberGrid" ItemsSource="{Binding Members}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
    <DataGrid.Columns><DataGridTextColumn Header="Stable module ID" Binding="{Binding ModuleId}" Width="170"/><DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" Width="*"/><DataGridTextColumn Header="Module Baseline (separate from Set)" Binding="{Binding Version}" Width="230"/><DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/><DataGridCheckBoxColumn Header="Missing" Binding="{Binding Missing}"/></DataGrid.Columns>
   </DataGrid></TabItem>
   <TabItem Header="Jobs / Reconciliation / Export"><DockPanel>
    <WrapPanel DockPanel.Dock="Top"><Button Content="Job History" Command="{Binding HistoryCommand}"/><Button Content="Open Job" Command="{Binding OpenJobCommand}"/><Button Content="Reconcile (read-only)" Command="{Binding ReconcileCommand}"/>
     <ComboBox Width="75" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/><Button Content="Export Current Job" Command="{Binding ExportCommand}"/><TextBox Width="230" Text="{Binding ExportRoot, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
    <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True">
     <DataGrid.Columns><DataGridTextColumn Header="JobId" Binding="{Binding JobId}" Width="255"/><DataGridTextColumn Header="Action" Binding="{Binding Request.Action}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/><DataGridTextColumn Header="Started UTC" Binding="{Binding StartedAtUtc, StringFormat=O}" Width="180"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns>
    </DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
