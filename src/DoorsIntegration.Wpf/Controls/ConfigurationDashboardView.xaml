<UserControl x:Class="DoorsIntegration.Wpf.Controls.ConfigurationDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="6,8,6,2"/><Setter Property="Foreground" Value="#A8C7E2"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/></Style>
  <DataTemplate x:Key="ChartRow"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Group}" FontSize="10" Foreground="#A8C7E2"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value}"/><StackPanel Grid.Column="2"><ProgressBar Value="{Binding Percentage,Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Foreground="#35A5F5"/><TextBlock Text="{Binding Quality}" FontSize="11"/></StackPanel></Grid></DataTemplate>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding Banner}" FontSize="17" Foreground="#62B9FF"/><TextBlock Text="{Binding AsOf}" TextWrapping="Wrap"/>
   <WrapPanel IsEnabled="{Binding IsIdle}"><ComboBox x:Name="DashboardEnvironment" Width="240" ItemsSource="{Binding Environments}" SelectedItem="{Binding EnvironmentId,UpdateSourceTrigger=PropertyChanged}" ToolTip="Environment identity; observe Real session before choosing a new database"/><TextBox Width="260" Text="{Binding Projects,UpdateSourceTrigger=PropertyChanged}" ToolTip="Project selector: canonical paths separated by semicolons"/><ComboBox Width="230" ItemsSource="{Binding ScopeKinds}" SelectedItem="{Binding ScopeKind}" ToolTip="Scope"/><Button Content="Export" Command="{Binding ExportCommand}"/></WrapPanel>
   <WrapPanel><Button Content="Load Cached" Command="{Binding LoadCachedCommand}"/><ComboBox ItemsSource="{Binding RefreshSections}" SelectedItem="{Binding RefreshSection}" Width="145"/><Button Content="Refresh Existing Results" Command="{Binding RefreshCommand}"/><Button Content="Run New Analysis (read-only)" Command="{Binding RunAnalysisCommand}"/><Button Content="Invalidate Cache" Command="{Binding InvalidateCommand}"/></WrapPanel>
  </StackPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Kpis}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Margin="3" Padding="8" HorizontalContentAlignment="Stretch" ToolTip="{Binding Metric.Warning}"><StackPanel><TextBlock Text="{Binding Metric.Name}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding Metric.DisplayValue}" FontSize="25" Foreground="#69BBFF"/><TextBlock Text="{Binding Metric.DisplayQuality}" TextWrapping="Wrap" FontSize="10"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="5" Foreground="#F5CD8A"/>
  <TabControl Grid.Row="3">
   <TabItem Header="Overview"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="120"/></Grid.RowDefinitions><TextBlock Text="Observed counts / labelled lower bounds. Unknown is not zero. Select a module or finding for exact drill-down." TextWrapping="Wrap" Margin="5"/><DataGrid Grid.Row="1" ItemsSource="{Binding Metrics}"><DataGrid.Columns><DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}"/><DataGridTextColumn Header="Quality" Binding="{Binding DisplayQuality}" Width="150"/><DataGridTextColumn Header="As of UTC" Binding="{Binding TimestampUtc}" Width="160"/><DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="*"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="2" IsReadOnly="True" Text="{Binding ScoreSummary,Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
   <TabItem Header="Scope / filters"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsIdle}">
    <TextBlock Text="Environment / Database identity" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="300" Text="{Binding EnvironmentId,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="300" Text="{Binding DatabaseIdentity,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Observe Real Environment" Command="{Binding ObserveEnvironmentCommand}"/></WrapPanel>
    <TextBlock Text="Scope / Projects (semicolon-separated canonical paths)" Style="{StaticResource Label}"/><WrapPanel><ComboBox Width="250" ItemsSource="{Binding ScopeKinds}" SelectedItem="{Binding ScopeKind}"/><TextBox Width="430" Text="{Binding Projects,UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
    <WrapPanel><TextBox Width="360" Text="{Binding FolderInput,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add Folder" Command="{Binding AddFolderCommand}"/><Button Content="Clear Folders" Command="{Binding ClearFoldersCommand}"/></WrapPanel>
    <DataGrid Height="115" ItemsSource="{Binding Folders}" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Folders" Binding="{Binding FullPath,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridCheckBoxColumn Header="Include subfolders" Binding="{Binding IncludeSubfolders,UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid>
    <Button Content="Add observed Workspace module (Real)" Command="{Binding UseWorkspaceModuleCommand}" HorizontalAlignment="Left"/>
    <DataGrid Height="150" ItemsSource="{Binding ModuleChoices}" IsReadOnly="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Selected" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Stable identity" Binding="{Binding ModuleIdentity}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Path" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/><DataGridCheckBoxColumn Header="Current" Binding="{Binding Current,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Major" Binding="{Binding Major,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Minor" Binding="{Binding Minor,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Suffix" Binding="{Binding Suffix,UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Baseline set: Folder / Definition identity / Set identity" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="240" Text="{Binding SetFolder,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="240" Text="{Binding DefinitionIdentity,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="240" Text="{Binding SetIdentity,UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
    <TextBlock Text="Link module paths (semicolon-separated)" Style="{StaticResource Label}"/><TextBox Text="{Binding LinkModules,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Filters: Project / Folder / Requirement type / Requirement status / Criticality" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="180" Text="{Binding ProjectFilter,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="180" Text="{Binding FolderFilter,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Text="{Binding RequirementType,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Text="{Binding RequirementStatus,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="110" Text="{Binding Criticality,UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
    <TextBlock Text="Finding severity / Baseline status / Review status" Style="{StaticResource Label}"/><WrapPanel><ComboBox Width="150" ItemsSource="{Binding Severities}" SelectedItem="{Binding FindingSeverity}"/><ComboBox Width="210" ItemsSource="{Binding BaselineStates}" SelectedItem="{Binding BaselineStatus}"/><ComboBox Width="190" ItemsSource="{Binding ReviewStates}" SelectedItem="{Binding ReviewStatus}"/><CheckBox Content="Failed / incomplete jobs only" IsChecked="{Binding FailedJobsOnly}"/></WrapPanel>
    <TextBlock Text="Analysis date from / to (ISO 8601)" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="300" Text="{Binding AnalysisFrom,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="300" Text="{Binding AnalysisTo,UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
    <TextBlock Text="Trace policy version / Quality profile version / Quality standard template" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="230" Text="{Binding TraceabilityPolicyVersion,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="230" Text="{Binding QualityProfileVersion,UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="160" ItemsSource="{Binding QualityStandards}" SelectedItem="{Binding QualityStandard}"/></WrapPanel>
    <WrapPanel><TextBox Width="420" Text="{Binding PolicyFile,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Load Trace Policy JSON" Command="{Binding LoadPolicyCommand}"/></WrapPanel><TextBox Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding TraceabilityPolicyJson,UpdateSourceTrigger=PropertyChanged}"/>
    <WrapPanel><TextBox Width="420" Text="{Binding QualityFile,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Load Custom Rule Profile JSON" Command="{Binding LoadQualityCommand}"/></WrapPanel><TextBox Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding QualityProfileJson,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Cache TTL seconds / Analysis max age seconds / Optional score weights" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="120" Text="{Binding CacheTtlSeconds,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Text="{Binding AnalysisMaxAgeSeconds,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Enable project health score" IsChecked="{Binding ScoreEnabled}"/></WrapPanel><TextBox Text="{Binding ScoreWeightsJson,UpdateSourceTrigger=PropertyChanged}"/>
    <WrapPanel><TextBox Width="240" Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Save Scope Profile" Command="{Binding SaveProfileCommand}"/><Button Content="Load Scope Profile" Command="{Binding LoadProfileCommand}"/></WrapPanel>
    <TextBlock Text="Only formal modules are eligible. Changing filters clears all displayed sections. No dashboard command creates baselines or changes DOORS records." TextWrapping="Wrap" Margin="7"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Baseline"><Grid><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ListBox ItemsSource="{Binding BaselineCharts}" ItemTemplate="{StaticResource ChartRow}"/><WrapPanel Grid.Row="1"><Button Content="Module Explorer" Command="{Binding OpenModuleCommand}"/><Button Content="Baseline Compare" Command="{Binding CompareModuleCommand}"/><Button Content="Bulk Baseline (select only)" Command="{Binding BulkModuleCommand}"/><Button Content="Previous" Command="{Binding PreviousModulesCommand}"/><Button Content="Next" Command="{Binding NextModulesCommand}"/></WrapPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"><DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding ModulePath}" Width="220"/><DataGridTextColumn Header="Latest" Binding="{Binding LatestBaseline}"/><DataGridTextColumn Header="Health" Binding="{Binding BaselineHealth}" Width="180"/><DataGridTextColumn Header="Access" Binding="{Binding Access}"/><DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Traceability"><ListBox ItemsSource="{Binding TraceCharts}" ItemTemplate="{StaticResource ChartRow}"/></TabItem>
   <TabItem Header="Change impact"><ListBox ItemsSource="{Binding ImpactCharts}" ItemTemplate="{StaticResource ChartRow}"/></TabItem>
   <TabItem Header="Quality"><ListBox ItemsSource="{Binding QualityCharts}" ItemTemplate="{StaticResource ChartRow}"/></TabItem>
   <TabItem Header="Findings"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Open Finding" Command="{Binding OpenFindingCommand}"/><Button Content="Previous" Command="{Binding PreviousFindingsCommand}"/><Button Content="Next" Command="{Binding NextFindingsCommand}"/><TextBlock Text="{Binding PageSummary}"/></WrapPanel><DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}"/><DataGridTextColumn Header="Module" Binding="{Binding ModuleIdentity}"/><DataGridTextColumn Header="Requirement" Binding="{Binding RequirementIdentity}" Width="160"/><DataGridTextColumn Header="Review" Binding="{Binding ReviewStatus}"/><DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="Activity"><DockPanel><Button DockPanel.Dock="Top" Content="Open Job History Detail" Command="{Binding OpenActivityCommand}" HorizontalAlignment="Left"/><DataGrid ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivity}"><DataGrid.Columns><DataGridTextColumn Header="Job" Binding="{Binding JobId}" Width="170"/><DataGridTextColumn Header="Type" Binding="{Binding JobType}"/><DataGridTextColumn Header="Operator" Binding="{Binding Operator}"/><DataGridTextColumn Header="Start UTC" Binding="{Binding StartTimeUtc}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="Modules" Binding="{Binding AffectedModuleCount}"/><DataGridTextColumn Header="Findings" Binding="{Binding FindingCount}"/><DataGridTextColumn Header="Error" Binding="{Binding ErrorSummary}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="History / trends"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><WrapPanel><Button Content="Snapshot History" Command="{Binding LoadHistoryCommand}"/><Button Content="Open Snapshot" Command="{Binding OpenHistoryCommand}"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="True"/><DataGrid Grid.Row="2" ItemsSource="{Binding Trends}" AutoGenerateColumns="True"/></Grid></TabItem>
   <TabItem Header="Export"><StackPanel><TextBlock Text="Reports identify source analyses, scope, policy versions and limitations. They are not automatically approved audit evidence or certification decisions." TextWrapping="Wrap" Margin="7"/><WrapPanel><ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding ReportKind}" Width="260"/><ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding Format}" Width="140"/><Button Content="Export Report" Command="{Binding ExportCommand}"/></WrapPanel><TextBox Text="{Binding ExportRoot,UpdateSourceTrigger=PropertyChanged}"/><TextBox IsReadOnly="True" Text="{Binding Warnings,Mode=OneWay}" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{Binding Performance}" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
  <Expander Grid.Row="4" Header="Selected evidence / data limitations"><Grid MaxHeight="180"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding Details,Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding Warnings,Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Expander>
 </Grid>
</UserControl>
