<UserControl x:Class="DoorsIntegration.Wpf.Controls.ModuleSelectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="95"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="55"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="BULK BASELINE / FORMAL MODÜL SEÇİMİ" FontSize="17" Margin="4,3,0,7"/>
            <TextBlock Text="Salt okunur keşif · Tümünü seç yalnız yüklenmiş ve filtreye uyan adayları kapsar · Mock katalog: /Bulk (1536 formal modül, erişim kısıtları dahil)" Style="{StaticResource MutedText}"/>
            <DockPanel><TextBlock Text="Repository bağlamı" Width="130"/><TextBox Text="{Binding RepositoryId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bu kaynak için kararlı repository etiketi; native module ID ayrıca doğrulanır."/></DockPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="Klasörü ekle" Command="{Binding AddFolderCommand}"/><CheckBox DockPanel.Dock="Right" Content="Alt klasörler" IsChecked="{Binding IncludeSubfolders}"/><TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam proje veya klasör yolu"/></DockPanel>
        </StackPanel>
        <DockPanel Grid.Row="1"><StackPanel DockPanel.Dock="Right" Margin="8,0,0,0"><Button Content="Klasörü kaldır" Command="{Binding RemoveFolderCommand}" MinHeight="26" Padding="8,3" Margin="2"/><Button Content="Klasördekileri seç" Command="{Binding SelectFolderCommand}" MinHeight="26" Padding="8,3" Margin="2"/><Button Content="Klasör seçimini kaldır" Command="{Binding DeselectFolderCommand}" MinHeight="26" Padding="8,3" Margin="2"/></StackPanel>
            <DataGrid x:Name="SelectionFolders" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" IsReadOnly="False"><DataGrid.Columns>
                <DataGridTextColumn Header="Seçili proje / klasör" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
                <DataGridTemplateColumn Header="Alt klasörler" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IncludeSubfolders, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid>
        </DockPanel>
        <StackPanel Grid.Row="2"><WrapPanel><Button Content="Sonraki grubu yükle" Command="{Binding LoadNextCommand}"/><Button Content="Yeniden başlat" Command="{Binding RestartCommand}"/>
                <Button Content="Tümünü seç (görünür)" Command="{Binding SelectAllCommand}"/><Button Content="Görünür seçimi kaldır" Command="{Binding DeselectVisibleCommand}"/><Button Content="Tüm seçimi kaldır" Command="{Binding DeselectAllCommand}"/></WrapPanel>
            <DockPanel><CheckBox DockPanel.Dock="Right" Content="Yalnız seçilenler" IsChecked="{Binding SelectedOnly}"/><ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding AccessFilters}" SelectedItem="{Binding Access}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" ToolTip="Modül adı, canonical yol veya stabil kimlik ile ara"/></DockPanel>
            <TextBlock Text="{Binding Summary}" Margin="4,4,0,7"/>
        </StackPanel>
        <DataGrid Grid.Row="3" x:Name="SelectionModules" ItemsSource="{Binding Rows}" IsReadOnly="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns>
            <DataGridTemplateColumn Header="Seç" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsEnabled="{Binding Candidate.CanSelect}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Modül adı" Binding="{Binding Candidate.Name}" IsReadOnly="True" Width="170"/>
            <DataGridTextColumn Header="Canonical full path" Binding="{Binding Candidate.FullPath}" IsReadOnly="True" Width="2*"/>
            <DataGridTextColumn Header="Tür" Binding="{Binding Candidate.Type}" IsReadOnly="True" Width="105"/>
            <DataGridTextColumn Header="Erişim" Binding="{Binding Candidate.Access}" IsReadOnly="True" Width="105"/>
            <DataGridTextColumn Header="Son mevcut baseline" Binding="{Binding Baseline}" IsReadOnly="True" Width="150"/>
            <DataGridTextColumn Header="Stabil modül kimliği" Binding="{Binding Candidate.Module.ModuleId}" IsReadOnly="True" Width="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Candidate.Module.ModuleId}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="Açıklama" Binding="{Binding Candidate.FailureReason}" IsReadOnly="True" Width="*"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="4" Margin="0,7,0,0"><DockPanel><TextBlock Text="Profil adı" Width="80"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Width="190" HorizontalAlignment="Left"/><TextBox Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="JSON profil dosyası; kayıtta yeni dosya adı kullanın."/></DockPanel>
            <WrapPanel><Button Content="Profili kaydet (yeni dosya)" Command="{Binding SaveProfileCommand}"/><Button Content="Profili yükle" Command="{Binding LoadProfileCommand}"/><Button Content="Seçilenlerden Dry Run / Ön kontrol" Command="{Binding PlanCommand}"/></WrapPanel>
        </StackPanel>
        <TextBox Grid.Row="5" IsReadOnly="True" Text="{Binding Report, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
