<Window x:Class="DoorsIntegration.Wpf.GoToWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go To / Git" Style="{StaticResource {x:Type Window}}" Width="590" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Window.InputBindings><KeyBinding Key="Escape" Command="Close"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="Close" Executed="OnClose"/></Window.CommandBindings>
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,13"><TextBlock Text="NESNEYE GİT" FontSize="17" Foreground="#62B9FF"/><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="1" IsEnabled="{Binding IsIdle}" Margin="0,0,14,0"><Label Content="Hedef _türü:" Target="{Binding ElementName=GoToKind}" Foreground="{StaticResource Text}"/><ComboBox x:Name="GoToKind" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Go to kind"/>
   <Label Content="Hedef _değer:" Target="{Binding ElementName=GoToText}" Foreground="{StaticResource Text}"/><TextBox x:Name="GoToText" Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Go to value"/>
   <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,7,4,9"/>
   <CheckBox x:Name="ClearFilters" Content="Filtreleri temizleyerek git" IsChecked="{Binding ClearFilters}" Margin="4,5"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,24,0,0"><Button Content="Git" Command="{Binding GoCommand}" IsDefault="True"/><Button Content="Kapat" Command="Close" Margin="3,15,3,3"/></StackPanel>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#F5CD8A" Margin="2,14,2,10" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Yalnız okunmuş modül/baseline snapshot'ında tam eşleşmeyle gider. Gizli hedefler için filtreleri temizlemeyi ayrıca seçin. Belirsiz hedef seçilmez. DOORS'a yazmaz. Enter: git · Esc: kapat." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
 </Grid>
</Window>
