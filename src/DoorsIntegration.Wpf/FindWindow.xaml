<Window x:Class="DoorsIntegration.Wpf.FindWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find / Bul" Style="{StaticResource {x:Type Window}}" Width="590" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Window.InputBindings><KeyBinding Key="Escape" Command="Close"/><KeyBinding Key="F3" Command="{Binding NextCommand}"/><KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousCommand}"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="Close" Executed="OnClose"/></Window.CommandBindings>
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="MODÜL İÇİNDE BUL" FontSize="17" Foreground="#62B9FF"/><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="1" IsEnabled="{Binding IsIdle}" Margin="0,0,14,0"><Label Content="Aranacak _metin:" Target="{Binding ElementName=FindText}" Foreground="{StaticResource Text}"/><TextBox x:Name="FindText" Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Find what" MinWidth="330"/>
   <CheckBox x:Name="MatchCase" Content="Match case — büyük/küçük harf" IsChecked="{Binding MatchCase}" Margin="4,13,4,5"/><CheckBox x:Name="WholeWord" Content="Whole word — tam sözcük" IsChecked="{Binding WholeWord}" Margin="4,5"/><CheckBox Content="Wrap around — baştan devam et" IsChecked="{Binding Wrap}" Margin="4,5"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,23,0,0"><Button Content="Sonrakini bul" Command="{Binding NextCommand}" IsDefault="True"/><Button Content="Öncekini bul" Command="{Binding PreviousCommand}"/><Button Content="Kapat" Command="Close" Margin="3,15,3,3"/></StackPanel>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#F5CD8A" Margin="2,14,2,10" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Okunmuş snapshot'ın tamamında, mevcut Ara ve Aktif/Silinmiş filtreleri içinde arar. Her eşleşen gereksinim bir sonuçtur. DOORS'a yazmaz. Enter / F3: sonraki · Shift+F3: önceki · Esc: kapat." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
 </Grid>
</Window>
