<Window x:Class="DoorsIntegration.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DoorsIntegration.Wpf.Controls" xmlns:commands="clr-namespace:DoorsIntegration.Wpf.Infrastructure"
        Title="DOORS Integration · Desktop" Style="{StaticResource {x:Type Window}}" Width="1480" Height="960" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
    <Window.CommandBindings><CommandBinding Command="Find" Executed="OnFind" CanExecute="CanFind"/><CommandBinding Command="{x:Static commands:WorkspaceNavigationCommands.GoTo}" Executed="OnGoTo" CanExecute="CanFind"/></Window.CommandBindings>
    <Window.InputBindings><KeyBinding Command="Find" Gesture="Ctrl+F"/><KeyBinding Command="{x:Static commands:WorkspaceNavigationCommands.GoTo}" Gesture="Ctrl+G"/><KeyBinding Key="F3" Command="{Binding Find.NextCommand}"/><KeyBinding Key="F3" Modifiers="Shift" Command="{Binding Find.PreviousCommand}"/></Window.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="DOORS / REQUIREMENTS WORKSPACE" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Keşif · Düzenleme · Toplu işlemler · Analiz · Diagnostics" Style="{StaticResource MutedText}"/></StackPanel>
            <Border Grid.Column="1" Background="#173F50" Padding="15,8" CornerRadius="6" VerticalAlignment="Center"><TextBlock Text="{Binding ModeLabel}" Foreground="#88DDD3" FontWeight="SemiBold"/></Border>
        </Grid>
        <WrapPanel Grid.Row="1" IsEnabled="{Binding IsIdle}">
            <TextBlock Text="Kaynak" Margin="0,0,6,0"/><ComboBox x:Name="ModeSelector" Width="130" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
            <TextBlock Text="Profil" Margin="10,0,3,0"/><ComboBox Width="85" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}"/>
            <ComboBox Width="155" ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection}"/>
            <Button Content="Offline diagnostics" Command="{Binding DiagnoseCommand}"/><Button Content="Ping / bağlantıyı doğrula" Command="{Binding PingCommand}"/>
            <Button Content="DXL Ping (isolated)" Command="{Binding IsolatedPingCommand}" ToolTip="Read-only runStr / Result; fresh request token; no discovery parser. Mock reports NOT_RUN."/>
            <CheckBox Content="Salt okunur mod" IsChecked="{Binding IsReadOnly}" Margin="12,0,0,0" ToolTip="Kapatmak yalnız yazma komutlarını açar. Dry-run ve açık kullanıcı onayı yine zorunludur."/>
        </WrapPanel>
        <TextBlock Grid.Row="2" Text="{Binding ProfileDescription}" Style="{StaticResource MutedText}" Margin="3,6,0,12"/>
        <TabControl Grid.Row="3" x:Name="WorkspaceTabs">
            <TabItem Header="Workspace">
                <Grid IsEnabled="{Binding IsIdle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="235" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="335" MinWidth="270"/></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,7,0">
                        <StackPanel DockPanel.Dock="Top"><TextBlock Text="PROJECTS &amp; MODULES" FontWeight="SemiBold" Margin="4,5,0,9"/>
                            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam keşif kök yolu"/>
                            <Button Content="Ağacı keşfet" Command="{Binding DiscoverCommand}" Margin="3,5,3,9"/>
                            <Expander Header="Dashboard scope modules"><StackPanel><ComboBox ItemsSource="{Binding DashboardSources}" SelectedItem="{Binding SelectedDashboardSource}" DisplayMemberPath="FullPath"/><Button Content="Open exact snapshot version" Command="{Binding OpenDashboardSourceCommand}"/></StackPanel></Expander>
                            <TextBlock Text="Formal modülü seçerek okuyun. Erişim durumları ağaçta korunur." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <TreeView x:Name="ProjectTree" ItemsSource="{Binding Tree}" SelectedItemChanged="OnTreeSelectionChanged">
                            <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.FullPath}"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></HierarchicalDataTemplate></TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1"/>
                    <DockPanel Grid.Column="2" Margin="9,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="REQUIREMENTS" FontWeight="SemiBold" Margin="4,5,0,8"/>
                            <DockPanel><Button DockPanel.Dock="Right" Content="Oku" Command="{Binding ReadCommand}"/><TextBox Text="{Binding ModulePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam formal modül yolu"/></DockPanel>
                            <DockPanel><TextBlock Text="Özel alanlar" Width="85"/><TextBox Text="{Binding CustomAttributes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Virgül veya noktalı virgülle ayrılmış adlar"/></DockPanel>
                            <DockPanel Margin="0,5,0,8"><Button DockPanel.Dock="Right" Content="Git…" Command="{x:Static commands:WorkspaceNavigationCommands.GoTo}" ToolTip="Klasik Go To penceresi (Ctrl+G)"/><Button DockPanel.Dock="Right" Content="Bul…" Command="Find" ToolTip="Klasik Find penceresi (Ctrl+F)"/><Button DockPanel.Dock="Right" Content="Ara" Command="{Binding SearchCommand}"/><ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam snapshot içinde metin / kimlik araması (en çok 256 karakter)"/></DockPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal"><Button Content="← Önceki" Command="{Binding PreviousCommand}"/><Button Content="Sonraki →" Command="{Binding NextCommand}"/></StackPanel></StackPanel>
                        <DataGrid x:Name="RequirementsGrid" ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement}" SelectionChanged="OnRequirementSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="90"/>
                                <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="55"/>
                                <DataGridTextColumn Header="Heading" Binding="{Binding Heading}" Width="*"/>
                                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="1.3*"/>
                                <DataGridTextColumn Header="Read status" Binding="{Binding ContentStatus}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="3"/>
                    <DockPanel Grid.Column="4" Margin="10,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="OBJECT DETAILS" FontWeight="SemiBold" Margin="4,5,0,10"/>
                        <TabControl>
                            <TabItem Header="Attributes"><Grid><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="100"/></Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute}"><DataGrid.Columns><DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding PlainStatus}" Width="100"/></DataGrid.Columns></DataGrid>
                                <TextBlock Grid.Row="1" Text="{Binding SelectedAttribute.Type}" Style="{StaticResource MutedText}"/>
                                <TextBox Grid.Row="2" IsReadOnly="True" Text="{Binding SelectedAttribute.Plain, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Grid.Row="3" Text="Opaque RTF/OLE · çalıştırılmaz / render edilmez" Style="{StaticResource MutedText}"/>
                                <TextBox Grid.Row="4" IsReadOnly="True" Text="{Binding SelectedAttribute.RawRich, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid></TabItem>
                            <TabItem Header="Links"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="Link kapsamını oku" Command="{Binding LinksCommand}"/><TextBlock Text="Graph sekmesinde link module yolunu seçin. Okuduktan sonra nesneyi tekrar seçin; en çok 100 ilgili link gösterilir." Style="{StaticResource MutedText}"/></StackPanel><ListBox ItemsSource="{Binding RelatedLinks}" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="3,7"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Baseline diff">
                <DockPanel IsEnabled="{Binding IsIdle}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="İki mevcut baseline · aynı native modül kimliği · salt okunur" FontSize="17" Margin="4,2,0,8"/>
                        <DockPanel><TextBlock Text="Modül" Width="80"/><TextBox Text="{Binding ModulePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                        <WrapPanel><TextBlock Text="Önce  major / minor / suffix" Width="175"/><TextBox Width="55" Text="{Binding BeforeMajor, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="55" Text="{Binding BeforeMinor, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="90" Text="{Binding BeforeSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Sonra" Margin="18,0,6,0"/><TextBox Width="55" Text="{Binding AfterMajor, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="55" Text="{Binding AfterMinor, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="90" Text="{Binding AfterSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Plain text: exact" IsChecked="{Binding ExactText}"/><Button Content="Karşılaştır" Command="{Binding CompareCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="Varsayılan plain karşılaştırma: NFC + satır sonları. Opaque rich text birebir karşılaştırılır. Özel alan seçimi Workspace'ten gelir." Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding DiffSummary}" TextWrapping="Wrap" Margin="4,6,4,10"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,7,0,0"><Button Content="← Önceki" Command="{Binding DiffPreviousCommand}"/><Button Content="Sonraki →" Command="{Binding DiffNextCommand}"/><TextBlock Text="{Binding DiffPageLabel}" Margin="12,0"/></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="DiffGrid" ItemsSource="{Binding DiffRows}" SelectedItem="{Binding SelectedDiff}" SelectionChanged="OnDiffSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Object" Binding="{Binding Identifier}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridCheckBoxColumn Header="Conclusive" Binding="{Binding IsConclusive, Mode=OneWay}" Width="85"/><DataGridTextColumn Header="Attribute differences" Binding="{Binding Fields}" Width="*"/></DataGrid.Columns></DataGrid>
                        <GridSplitter Grid.Column="1"/><TextBox Grid.Column="2" Margin="10,0,0,0" IsReadOnly="True" Text="{Binding DiffDetails, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Traceability graph">
                <DockPanel IsEnabled="{Binding IsIdle}">
                    <StackPanel DockPanel.Dock="Top"><TextBlock Text="SOURCE → TARGET / TRACEABILITY" FontSize="17" Margin="4,3,0,10"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Linkleri oku" Command="{Binding LinksCommand}"/><TextBlock Text="Link module" Width="95"/><TextBox Text="{Binding LinkPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                        <TextBlock Text="Mavi: çözümlenmiş ilişki · Kesikli sarı: unresolved / referans / erişim kısıtı. Grafik kapsamın tamamı veya coverage kanıtı değildir." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LinkSummary}" TextWrapping="Wrap" Margin="4,3,4,9"/>
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" Height="80" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding GraphDetail, Mode=OneWay}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><controls:TraceabilityGraph x:Name="Graph" Links="{Binding GraphLinks}"/></ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Connection diagnostics">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Offline: registry ve binary metadatası. Ping: COM + DXL + cevap + cleanup ayrı adımlar. Native çağrı UI thread üzerinde çalışmaz; başladıktan sonra zorla iptal edilemez." Style="{StaticResource MutedText}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HealthSteps}"><DataGrid.Columns><DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Code" Binding="{Binding ErrorCode}" Width="110"/><DataGridTextColumn Header="Explanation" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
                    <TextBox Grid.Row="2" Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Export">
                <StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="850" HorizontalAlignment="Left">
                    <TextBlock Text="EXPORT / RETAINED SNAPSHOTS" FontSize="18" Margin="4,4,0,12"/>
                    <TextBlock Text="JSON, CSV veya XLSX. Filtre ve sayfa yalnız görünümü etkiler; seçilen snapshot'ın tamamı aktarılır. BaselineDiff kapsamını ayrıca seçin." Style="{StaticResource MutedText}"/>
                    <WrapPanel><TextBlock Text="Kapsam" Width="75"/><ComboBox Width="200" ItemsSource="{Binding ExportScopes}" SelectedItem="{Binding ExportScope}"/><TextBlock Text="Format" Margin="15,0,5,0"/><ComboBox Width="130" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ExportFormat}"/></WrapPanel>
                    <TextBlock Text="Çıktı kök klasörü (her export yeni bir alt klasör oluşturur)" Margin="4,15,0,4"/><TextBox MinWidth="650" Text="{Binding ExportRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Dışa aktar" Command="{Binding ExportCommand}" HorizontalAlignment="Left" Margin="3,12,0,12"/>
                    <TextBlock Text="UTF-8, UTC tarih, null/boş ayrımı ve hata raporu korunur. Uzun rich/OLE değerler ValueChunks içinde kayıpsız taşınır. Excel/Office kurulumu gerekmez." Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding LastExportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="İşlemler &amp; Settings">
                <controls:OperationsView DataContext="{Binding Tools}" IsEnabled="{Binding IsIdle}"/>
            </TabItem>
            <TabItem Header="Bulk baseline / Modül seçimi">
                <Grid IsEnabled="{Binding IsIdle}"><controls:ModuleSelectionView DataContext="{Binding BulkSelection}"/></Grid>
            </TabItem>
            <TabItem x:Name="BulkDryRunTab" Header="Bulk baseline / Dry run">
                <Grid IsEnabled="{Binding IsIdle}"><controls:BulkBaselinePreflightView DataContext="{Binding BulkSelection}"/></Grid>
            </TabItem>
            <TabItem Header="Bulk Baseline Manager">
                <controls:BulkBaselineManagerView DataContext="{Binding BaselineManager}"/>
            </TabItem>
            <TabItem Header="Baseline Traceability"><controls:BaselineTraceabilityView DataContext="{Binding BaselineTraceability}"/></TabItem>
            <TabItem Header="Change Impact Analysis"><controls:ChangeImpactView DataContext="{Binding ChangeImpact}"/></TabItem>
            <TabItem Header="Configuration Dashboard"><controls:ConfigurationDashboardView DataContext="{Binding Dashboard}"/></TabItem>
        </TabControl>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <StackPanel><Expander x:Name="DashboardContextExpander" Header="Dashboard drill-down context"><TextBox IsReadOnly="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding DashboardContext,Mode=OneWay}"/></Expander><TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}"/><ProgressBar Margin="0,7,10,7" Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Foreground="#39A9F4" Background="#20374D"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            <Button Grid.Column="1" Content="İptal iste" Command="{Binding CancelCommand}" VerticalAlignment="Top"/>
        </Grid>
        <TextBox Grid.Row="5" Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="85" VerticalScrollBarVisibility="Auto" Foreground="#FFB8A8">
            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding ErrorDetails}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
    </Grid>
</Window>
